{
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "npx convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd 'bun run build'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/listings", "destination": "/index.html" },
    { "source": "/listings/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" }
  ]
}
