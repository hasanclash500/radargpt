# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=


# Neshan Web SDK key (client-side; restrict it to your production domains in Neshan panel)
VITE_NESHAN_MAP_KEY=


# Server-side AI provider for Meka Assistant (never prefix with VITE_)
# A free OpenRouter account key can be used with a free model/router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
SITE_URL=https://example.com
